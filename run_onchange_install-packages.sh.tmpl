#! /bin/bash
set -euo pipefail

log() { echo "==> $*"; }

{{ if eq .chezmoi.osRelease.id "ubuntu" -}}

#######
# apt #
#######

if ! compgen -G "/etc/apt/sources.list.d/fish*" > /dev/null; then
  sudo add-apt-repository -y ppa:fish-shell/release-4
fi

{{ if (or (eq .system_type "personal") (eq .system_type "canonical")) }}

if [[ ! -f /etc/apt/sources.list.d/github-cli.sources ]]; then
  log "Setting up GitHub CLI PPA..."
  sudo mkdir -p -m 755 /etc/apt/keyrings
  wget -nv -O- https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
  sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
  printf "Types: deb\nURIs: https://cli.github.com/packages\nSuites: stable\nComponents: main\nArchitectures: $(dpkg --print-architecture)\nSigned-By: /etc/apt/keyrings/githubcli-archive-keyring.gpg\n" | sudo tee /etc/apt/sources.list.d/github-cli.sources > /dev/null
  sudo rm -f /etc/apt/sources.list.d/github-cli.list
fi

{{ end }}

log "Updating apt..."
sudo apt-get update

APT_PACKAGES=(
  curl
  fish
  git
  npm
  snapd
  ripgrep
  tree
  wget
  vim
)

{{ if (or (eq .system_type "personal") (eq .system_type "canonical")) }}

APT_PACKAGES+=(
  build-essential
  ddcutil
  direnv
  fprintd
  gh
  gitk
  libpam-fprintd
)

{{ end }}

log "Installing apt packages..."
sudo apt-get install -y "${APT_PACKAGES[@]}"

if ! grep -qxF "$(command -v fish)" /etc/shells; then
  log "Adding fish to /etc/shells..."
  command -v fish | sudo tee -a /etc/shells
fi

# server scripts don't play well with fish :(
{{ if (or (eq .system_type "personal") (eq .system_type "canonical")) }}

if [ "$SHELL" != "$(command -v fish)" ]; then
  log "Setting fish as the default shell..."
  chsh -s "$(command -v fish)"
fi

{{ end }}

#########
# snaps #
#########

snap_install() {
    snap list "$1" &>/dev/null || sudo snap install "$@"
}

log "Installing snaps..."
snap_install helix --edge --classic

{{ if (or (eq .system_type "personal") (eq .system_type "canonical")) }}

snap_install bash-language-server --classic
snap_install ruff
snap_install shfmt
snap_install shellcheck

log "Installing yaml-language-server..."
sudo npm install -g yaml-language-server

  log "Installing personal/canonical snaps..."
  snap_install astral-uv --classic
  snap_install go --classic
  snap_install lxd
  lxd init --auto 2>/dev/null || true
  snap_install obsidian --classic
  snap_install rustup --classic
  rustup default stable
  rustup component add rust-analyzer
  log "Installing python-lsp-server..."
  uv tool install python-lsp-server
{{ end }}

{{ if eq .system_type "canonical" }}
log "Installing canonical snaps..."
snap_install google-cloud-sdk
snap_install pycharm-community --classic
{{ end }}


#########
# tools #
#########

{{ if (or (eq .system_type "personal") (eq .system_type "canonical")) }}

if command -v starship >/dev/null 2>&1; then
  log "starship is already installed"
else
  log "Installing starship..."
  wget -qO- https://starship.rs/install.sh | sh
fi

if command -v kitty >/dev/null 2>&1; then
  log "Kitty is already installed."
else
  log "Installing Kitty..."
  curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin
  echo "To integrate kitty in the desktop, see:"
  echo "https://sw.kovidgoyal.net/kitty/binary/"
fi

log "Installing harper-ls..."
HARPER_ASSET="harper-ls-x86_64-unknown-linux-gnu.tar.gz"
HARPER_URL=$(curl -fsSL https://api.github.com/repos/Automattic/harper/releases/latest \
  | grep "browser_download_url.*${HARPER_ASSET}" \
  | cut -d '"' -f 4)
HARPER_TMPDIR=$(mktemp -d)
curl -fsSL "$HARPER_URL" -o "$HARPER_TMPDIR/harper-ls.tar.gz"
tar -xzf "$HARPER_TMPDIR/harper-ls.tar.gz" -C "$HARPER_TMPDIR"
mkdir -p "$HOME/.local/bin"
install -m 755 "$HARPER_TMPDIR/harper-ls" "$HOME/.local/bin/harper-ls"
rm -rf "$HARPER_TMPDIR"

{{ end }}


###############
# virtual box #
###############

{{ if eq .system_type "personal" }}

VBOX_SOURCE="/etc/apt/sources.list.d/virtualbox.sources"

if [[ ! -f "$VBOX_SOURCE" ]]; then
  sudo tee "$VBOX_SOURCE" > /dev/null <<'EOF'
Types: deb
URIs: https://download.virtualbox.org/virtualbox/debian
Suites: {{- .chezmoi.osRelease.versionCodename }}
Components: contrib
Architectures: amd64
Signed-By: /usr/share/keyrings/oracle-virtualbox-2016.gpg
EOF
  echo "Created $VBOX_SOURCE"
  wget -O- https://www.virtualbox.org/download/oracle_vbox_2016.asc | sudo gpg --yes --output /usr/share/keyrings/oracle-virtualbox-2016.gpg --dearmor
  log "Installing VirtualBox..."
  sudo apt-get update
  sudo apt-get install -y virtualbox-7.2
  echo "run:"
  echo "sudo modprobe -r kvm_amd"
  echo "echo 'blacklist kvm_amd' >> /etc/modprobe.d/blacklist.conf"
  echo "(https://superuser.com/a/1874448)"
else
  log "$VBOX_SOURCE already exists."
fi
# end if personal
{{ end -}}

# end if ubuntu
{{ end -}}
