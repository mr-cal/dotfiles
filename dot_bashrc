case $- in
# If not running interactively, don't do anything
    *i*) ;;
      *) return;;
esac

# enable programmable completion features
# (you don't need to enable this, if it's already enabled in /etc/bash.bashrc and /etc/profile sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# check the window size after each command and, if necessary, update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will match all files and zero or more directories and subdirectories.
shopt -s globstar

export TERM=xterm-256color

alias c="cd"

alias ctmp='cd "$(mktemp -d)"'

alias cdsc="clear; cd ~/dev/craft/snapcraft"
alias cdscu="clear; cd ~/dev/craft/snapcraft-uv"
alias cdsce="clear; cd ~/dev/snaps/snapcraft-examples"

alias cdcpa="clear; cd ~/dev/craft/craft-parts"
alias cdcpae="clear; cd ~/dev/craft/craft-parts-examples"

alias cdcc="clear; cd ~/dev/craft/charmcraft"
alias cdcce="clear; cd ~/dev/charms/charmcraft-examples"

alias cdsoc="clear; cd ~/dev/craft/sourcecraft"
alias cdsoce="clear; cd ~/dev/sources/sourcecraft-examples"

alias cdkc="clear; cd ~/dev/craft/kerncraft"
alias cdkce="clear; cd ~/dev/craft/kerncraft-examples"

alias cdic="clear; cd ~/dev/craft/imagecraft"
alias cdice="clear; cd ~/dev/craft/imagecraft-examples"

alias cdrc="clear; cd ~/dev/craft/rockcraft"
alias cdrce="clear; cd ~/dev/rocks/rockcraft-examples"

alias cdcap="clear; cd ~/dev/craft/craft-application"
alias cdcli="clear; cd ~/dev/craft/craft-cli"
alias cdcgr="clear; cd ~/dev/craft/craft-grammar"
alias cdcar="clear; cd ~/dev/craft/craft-archives"
alias cdcpl="clear; cd ~/dev/craft/craft-platforms"
alias cdcpr="clear; cd ~/dev/craft/craft-providers"
alias cdcst="clear; cd ~/dev/craft/craft-store"
alias cdsb="clear; cd ~/dev/craft/starbase"

alias cl="clear"
alias g="git"
alias l='ls -1hF'
alias la='ls -a1hF'
alias ll='ls -lhF'
alias lr='ls -1hR'
alias lc='clear; ls -1hF'
alias lxcs="lxc --project snapcraft"
alias lxcc="lxc --project charmcraft"
alias lxcr="lxc --project rockcraft"
alias lxck="lxc --project kerncraft"
alias pyt="clear; pytest --no-cov -vv"
alias pyts="clear; pytest --no-cov -vv --maxfail=1 --failed-first"
alias rg="rg --smart-case"
alias rgp="clear; rg --smart-case --type=py"
alias ss="source ~/dev/craft/snapcraft/.venv/bin/activate"
alias sr="source ~/dev/craft/rockcraft/.venv/bin/activate"
alias v="nvim"

# color support
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

export PS1="\[\e[92m\]\w>\[\e[m\] "

export PATH="$HOME/.local/bin/:$HOME/go/bin:$PATH"

shopt -s histappend
HISTCONTROL=ignoredups:erasedups
HISTSIZE=100000
HISTFILESIZE=100000
PROMPT_COMMAND='history -a'

[ -f ~/.fzf.bash ] && source ~/.fzf.bash

if command -v direnv &> /dev/null
then
    eval "$(direnv hook bash)"
fi

# BEGIN_KITTY_SHELL_INTEGRATION
if test -n "$KITTY_INSTALLATION_DIR" -a -e "$KITTY_INSTALLATION_DIR/shell-integration/bash/kitty.bash"; then source "$KITTY_INSTALLATION_DIR/shell-integration/bash/kitty.bash"; fi
# END_KITTY_SHELL_INTEGRATION

# change colorschemes / theme
alias good-evening='ln -sf ~/.config/kitty/gruvbox-material-dark-medium.conf ~/.config/kitty/current-theme.conf && \
    kitten themes --reload-in=all "Gruvbox Material Dark Medium" && \
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"'
alias good-morning='ln -sf ~/.config/kitty/gruvbox-material-light-medium.conf ~/.config/kitty/current-theme.conf && \
    kitten themes --reload-in=all "Gruvbox Material Light Medium" && \
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"'

if [[ -e "$HOME/.config/config/canonical/source-store-creds.txt" ]]; then
  CRAFT_SOURCE_STORE_AUTH_TOKEN="$(cat $HOME/.config/config/canonical/source-store-creds.txt | tr -d \\n)"
fi

# set brightness of external monitors
alias sb='function _sb(){ sudo ddcutil setvcp 10 $1 --display 1; sudo ddcutil setvcp 10 $1 --display 2; }; _sb'
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# opencode
export PATH=/home/cal/.opencode/bin:$PATH

[ -f "$HOME/.config/local-llm/env" ] && source "$HOME/.config/local-llm/env"
export VOLTA_HOME="$HOME/.volta"
[[ -d "$VOLTA_HOME" ]] && export PATH="$VOLTA_HOME/bin:$PATH"
