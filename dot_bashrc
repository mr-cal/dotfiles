# Bash is the fallback shell; fish is the interactive shell.
#
# Shortcuts shared with fish live in .chezmoidata/shortcuts.yaml and are
# rendered into ~/.config/bash/shortcuts.sh, which is sourced below.

# If not running interactively, don't do anything.
case $- in
    *i*) ;;
    *) return ;;
esac

# Enable programmable completion features. Not needed if this is already
# enabled in /etc/bash.bashrc and /etc/profile sources /etc/bash.bashrc.
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# Make less more friendly for non-text input files, see lesspipe(1).
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# Check the window size after each command and update LINES and COLUMNS.
shopt -s checkwinsize

# Make "**" match files and zero or more directories and subdirectories.
shopt -s globstar

# history
shopt -s histappend
HISTCONTROL=ignoredups:erasedups
HISTSIZE=100000
HISTFILESIZE=100000
PROMPT_COMMAND='history -a'

export EDITOR=hx
PS1="\[\e[92m\]\w>\[\e[m\] "

# path
export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.opencode/bin:$PATH"
export VOLTA_HOME="$HOME/.volta"
[ -d "$VOLTA_HOME" ] && export PATH="$VOLTA_HOME/bin:$PATH"

# color support
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

##################################################
# shortcuts shared with fish (generated, see above)
##################################################

[ -f "$HOME/.config/bash/shortcuts.sh" ] && . "$HOME/.config/bash/shortcuts.sh"

####################
# bash-only extras #
####################

alias c="cd"
alias cl="clear"
alias g="git"
alias v="hx"
alias ctmp='cd "$(mktemp -d)"'

alias ss='source ~/dev/craft/snapcraft/.venv/bin/activate'
alias sr='source ~/dev/craft/rockcraft/.venv/bin/activate'

# dotfiles, see ~/.local/share/chezmoi/README.md
# These mirror the fish functions of the same name, minus the prompts.
alias dotdiff='chezmoi diff'
dotstatus() {
    local src
    src="$(chezmoi source-path)" || return 1
    echo '── $HOME vs. source dir ───'
    chezmoi status
    echo '── source dir vs. last commit ───'
    git -C "$src" status --short --branch
}
dotpull() {
    local src branch
    src="$(chezmoi source-path)" || return 1
    branch="$(git -C "$src" rev-parse --abbrev-ref HEAD)" || return 1
    git -C "$src" pull --rebase origin "$branch" && chezmoi diff && chezmoi apply -v
}
dotpush() {
    local src branch
    src="$(chezmoi source-path)" || return 1
    branch="$(git -C "$src" rev-parse --abbrev-ref HEAD)" || return 1
    chezmoi re-add -v &&
        git -C "$src" add -A &&
        git -C "$src" commit ${1:+-m "$1"} &&
        git -C "$src" push --set-upstream origin "$branch"
}

# Set the brightness of both external monitors.
sb() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: sb <brightness>" >&2
        return 1
    fi
    sudo ddcutil setvcp 10 "$1" --display 1 && sudo ddcutil setvcp 10 "$1" --display 2
}

# Switch between the light and dark colour schemes.
alias good-evening='ln -sf ~/.config/kitty/gruvbox-material-dark-medium.conf ~/.config/kitty/current-theme.conf && \
    kitten themes --reload-in=all "Gruvbox Material Dark Medium" && \
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"'
alias good-morning='ln -sf ~/.config/kitty/gruvbox-material-light-medium.conf ~/.config/kitty/current-theme.conf && \
    kitten themes --reload-in=all "Gruvbox Material Light Medium" && \
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"'

################
# integrations #
################

if [ -r "$HOME/.config/canonical/source-store-creds.txt" ]; then
    CRAFT_SOURCE_STORE_AUTH_TOKEN="$(tr -d '\n' <"$HOME/.config/canonical/source-store-creds.txt")"
    export CRAFT_SOURCE_STORE_AUTH_TOKEN
fi

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
[ -f "$HOME/.config/local-llm/env" ] && . "$HOME/.config/local-llm/env"
[ -f "$HOME/.fzf.bash" ] && . "$HOME/.fzf.bash"

if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook bash)"
fi

# BEGIN_KITTY_SHELL_INTEGRATION
if test -n "$KITTY_INSTALLATION_DIR" -a -e "$KITTY_INSTALLATION_DIR/shell-integration/bash/kitty.bash"; then source "$KITTY_INSTALLATION_DIR/shell-integration/bash/kitty.bash"; fi
# END_KITTY_SHELL_INTEGRATION
