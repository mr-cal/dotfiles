#!/usr/bin/env bash
# Switch kitty, helix and GNOME between the light, medium and dark themes.
# With --preview, only kitty and helix change (used by theme-pick).
set -euo pipefail

preview=false
if [ "${1:-}" = "--preview" ]; then
    preview=true
    shift
fi

case "${1:-}" in
medium) tone=dark-soft; scheme=prefer-light; gtk=Adwaita ;;
light) tone=light-stone; scheme=prefer-light; gtk=Adwaita ;;
dark) tone=dark-medium; scheme=prefer-dark; gtk=Adwaita-dark ;;
*)
    echo "Usage: theme-switch [--preview] light|medium|dark" >&2
    exit 1
    ;;
esac

ln -sf "$HOME/.config/kitty/gruvbox-material-$tone.conf" "$HOME/.config/kitty/current-theme.conf"
ln -sf "gruvbox-material-$tone.toml" "$HOME/.config/helix/themes/current.toml"
# Starship rereads its config on every prompt, so this takes effect immediately.
ln -sf "${tone%%-*}.toml" "$HOME/.config/starship/current.toml"

# SIGUSR1 makes kitty and helix reload their config; ignore if none are running.
pkill -USR1 -x kitty || true
pkill -USR1 -x hx || true

if ! $preview; then
    gsettings set org.gnome.desktop.interface color-scheme "$scheme"
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk"
fi
